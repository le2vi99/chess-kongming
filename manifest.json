{
  "manifest_version": 3,
  "name": "Chess Kongming",
  "version": "0.1.0",
  "description": "Local-engine chess tutor for chess.com bot games and analysis. Never active in live human games — see DESIGN.md section 1.",
  "permissions": ["sidePanel", "storage"],
  "host_permissions": ["http://localhost:11434/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "action": {
    "default_title": "Open Chess Kongming"
  },
  "side_panel": {
    "default_path": "dist/panel/panel.html"
  },
  "background": {
    "service_worker": "src/background/sw.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.chess.com/play/computer*",
        "https://www.chess.com/game/computer/*",
        "https://www.chess.com/analysis*"
      ],
      "js": ["dist/content/board.js"],
      "run_at": "document_idle"
    }
  ]
}
